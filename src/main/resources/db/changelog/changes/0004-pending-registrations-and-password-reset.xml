<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0004-01-create-pending-registrations" author="robert">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="pending_registrations"/>
            </not>
        </preConditions>

        <!--
            Poczekalnia rejestracji. Wiersz w users powstaje DOPIERO po potwierdzeniu adresu.

            Powód jest bezpieczeństwowy, nie porządkowy. Wcześniej rejestracja na istniejący,
            niepotwierdzony adres nadpisywała hasło w wierszu users. Napastnik mógł więc podmienić
            hasło w cudzej trwającej rejestracji, a ofiara, klikając najnowszy link ze swojej
            skrzynki, aktywowała konto z hasłem napastnika (atak "account pre-hijacking").

            Tutaj każde zgłoszenie to osobny wiersz z WŁASNYM tokenem i WŁASNYM hashem hasła.
            Kto klika swój link, dostaje swoje hasło - zgłoszenia obcych osób leżą obok
            i wygasają nieużyte.
        -->
        <createTable tableName="pending_registrations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_pending_registrations" nullable="false"/>
            </column>
            <!-- ŚWIADOMIE bez unikalności: kilka równoległych zgłoszeń na ten sam adres to
                 poprawny stan. Unikalność adresu obowiązuje dopiero w tabeli users. -->
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <!-- Hasło zahashowane BCryptem już na etapie zgłoszenia - w poczekalni nigdy
                 nie leży hasło jawnie, nawet gdyby zgłoszenie nigdy nie zostało potwierdzone. -->
            <column name="password_hash" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <!-- Jak przy pozostałych tokenach: w bazie wyłącznie SHA-256 (64 znaki hex) -->
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${type.datetime}">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="${type.datetime}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="pending_registrations"
                             columnNames="token_hash"
                             constraintName="uk_pending_registrations_token_hash"/>

        <!-- Pod sprawdzenie "czy trwa już zgłoszenie na ten adres" i pod sprzątanie po potwierdzeniu -->
        <createIndex indexName="idx_pending_registrations_email" tableName="pending_registrations">
            <column name="email"/>
        </createIndex>

        <createIndex indexName="idx_pending_registrations_expires_at" tableName="pending_registrations">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="0004-02-create-password-reset-tokens" author="robert">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="password_reset_tokens"/>
            </not>
        </preConditions>

        <!--
            Reset hasła. Bez tej ścieżki każde przejęcie lub zapomnienie hasła kończyło się
            ręczną robotą w bazie - konto nie dawało się odzyskać żadnym endpointem.
        -->
        <createTable tableName="password_reset_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_password_reset_tokens" nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${type.datetime}">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="${type.datetime}">
                <constraints nullable="false"/>
            </column>
            <!-- NULL = token niewykorzystany. Zużyty token zostaje w tabeli do wygaśnięcia,
                 żeby ponowne kliknięcie tego samego linku dało czytelny błąd, a nie
                 "nieprawidłowy token" - inaczej użytkownik nie wie, czy reset się udał. -->
            <column name="used_at" type="${type.datetime}"/>
        </createTable>

        <addUniqueConstraint tableName="password_reset_tokens"
                             columnNames="token_hash"
                             constraintName="uk_password_reset_tokens_token_hash"/>

        <createIndex indexName="idx_password_reset_tokens_expires_at" tableName="password_reset_tokens">
            <column name="expires_at"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="password_reset_tokens"
                                 baseColumnNames="user_id"
                                 constraintName="fk_password_reset_tokens_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="0004-03-drop-verification-tokens" author="robert">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="verification_tokens"/>
        </preConditions>

        <!--
            Zastąpione przez pending_registrations. Tokeny weryfikacyjne wskazywały na
            istniejący wiersz users (enabled=false), a właśnie ten model umożliwiał
            podmianę hasła w cudzej rejestracji.
        -->
        <dropTable tableName="verification_tokens"/>
    </changeSet>

    <changeSet id="0004-04-drop-users-enabled-created-at-index" author="robert">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="users" indexName="idx_users_enabled_created_at"/>
        </preConditions>

        <!--
            Indeks powstał w 0003 pod jedno zapytanie: wyszukiwanie porzuconych rejestracji
            w tabeli users. Po przeniesieniu poczekalni do osobnej tabeli nie ma już wierszy
            users z enabled=false, więc to zapytanie zniknęło razem z indeksem. Kolumnę
            created_at zostawiamy - jest przydatna audytowo.
        -->
        <dropIndex tableName="users" indexName="idx_users_enabled_created_at"/>
    </changeSet>

</databaseChangeLog>
