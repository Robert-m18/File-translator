<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Typy różniące się między silnikami baz danych.
        Dzięki temu ten sam changelog tworzy schemat zgodny z tym, czego oczekuje
        Hibernate (ddl-auto: validate) zarówno na MySQL (prod/dev), jak i na H2 (testy).
    -->
    <property name="type.datetime" value="DATETIME(6)"  dbms="mysql,mariadb"/>
    <property name="type.datetime" value="TIMESTAMP(6)" dbms="h2"/>
    <property name="type.boolean"  value="BIT(1)"       dbms="mysql,mariadb"/>
    <property name="type.boolean"  value="BOOLEAN"      dbms="h2"/>

    <!-- Każda zmiana schematu = nowy plik dołączony poniżej. Nigdy nie edytujemy już wykonanych changesetów. -->
    <include file="db/changelog/changes/0001-init-schema.xml"/>
    <include file="db/changelog/changes/0002-refresh-tokens-and-account-lockout.xml"/>

</databaseChangeLog>
