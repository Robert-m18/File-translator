<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Typy różniące się między silnikami baz danych.
        Dzięki temu ten sam changelog tworzy schemat zgodny z tym, czego oczekuje
        Hibernate (ddl-auto: validate) zarówno na PostgreSQL (prod/dev), jak i na H2 (testy).

        PostgreSQL i H2 mają tu identyczne wartości, więc dzielą jeden wpis. Warianty
        MySQL-a zostają, bo changesety 0001-0005 wykonały się już na tym silniku
        i muszą dawać ten sam wynik przy odtworzeniu historii - changesetu, który
        gdziekolwiek przeszedł, nie wolno zmieniać wstecz.
    -->
    <property name="type.datetime" value="TIMESTAMP(6)" dbms="postgresql,h2"/>
    <property name="type.boolean"  value="BOOLEAN"      dbms="postgresql,h2"/>
    <property name="type.datetime" value="DATETIME(6)"  dbms="mysql,mariadb"/>
    <property name="type.boolean"  value="BIT(1)"       dbms="mysql,mariadb"/>

    <!--
        type.datetime jest typem HISTORYCZNYM - zostaje wyłącznie dlatego, że changesety 0001-0005
        już się nim wykonały i muszą dawać ten sam wynik przy odtworzeniu historii. Changeset 0006
        przestawia wszystkie te kolumny na TIMESTAMP(6) WITH TIME ZONE.

        NOWE kolumny czasowe zakładaj od razu jako ${type.timestamptz} - kolumna bez strefy trzyma
        gołą ścianę zegara i nie mówi, czyj to zegar; wyjaśnienie w komentarzu changesetu 0006.
    -->
    <property name="type.timestamptz" value="TIMESTAMP(6) WITH TIME ZONE" dbms="postgresql,h2"/>

    <!-- Każda zmiana schematu = nowy plik dołączony poniżej. Nigdy nie edytujemy już wykonanych changesetów. -->
    <include file="db/changelog/changes/0001-init-schema.xml"/>
    <include file="db/changelog/changes/0002-refresh-tokens-and-account-lockout.xml"/>
    <include file="db/changelog/changes/0003-unconfirmed-account-cleanup.xml"/>
    <include file="db/changelog/changes/0004-pending-registrations-and-password-reset.xml"/>
    <include file="db/changelog/changes/0005-mail-outbox.xml"/>
    <include file="db/changelog/changes/0006-timestamps-with-time-zone.xml"/>
    <include file="db/changelog/changes/0007-translation-jobs.xml"/>
    <include file="db/changelog/changes/0008-translation-content-hash.xml"/>
    <include file="db/changelog/changes/0009-translation-billed-chars.xml"/>
    <include file="db/changelog/changes/0010-admin-account-block.xml"/>

</databaseChangeLog>
