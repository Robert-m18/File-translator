<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Import domyślnej konfiguracji Spring Boot -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Profil dev - więcej logów na konsolę -->
    <springProfile name="dev">
        <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}spring.log}"/>

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!-- [%X{traceId}] - identyfikator korelacji z MDC (patrz TraceIdFilter).
                     Pozwala wyfiltrować z logów wszystkie linie jednego żądania. -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE}</file>
            <encoder>
                <!-- [%X{traceId}] - identyfikator korelacji z MDC (patrz TraceIdFilter).
                     Pozwala wyfiltrować z logów wszystkie linie jednego żądania. -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>10</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- Więcej logów z naszej aplikacji -->
        <logger name="com.example.filetranslator" level="DEBUG"/>
        <!-- Mniej logów z Spring -->
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.security" level="DEBUG"/>
    </springProfile>

    <!-- Profil prod - mniej logów, na konsolę i na plik -->
    <springProfile name="prod">
        <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}spring.log}"/>

        <!-- Konsola JEST na produkcji obowiązkowa, mimo że niżej stoi appender do pliku.
             Aplikacja jedzie w kontenerze, a interfejsem logowania kontenera jest stdout:
             `docker compose logs app` i kolektor platformy hostingowej czytają WYŁĄCZNIE
             stdout. Plik żyje wewnątrz kontenera i znika razem z nim, więc sam plik oznacza
             wdrożenie, którego nie da się zdiagnozować - a prod to jedyny profil, na którym
             nie ma jak podejrzeć aplikacji inaczej. Plik zostaje dla wdrożeń poza kontenerem
             (VPS z systemd), gdzie katalog przeżywa restart procesu. -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!-- [%X{traceId}] - identyfikator korelacji z MDC (patrz TraceIdFilter).
                     Pozwala wyfiltrować z logów wszystkie linie jednego żądania. -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE}</file>
            <encoder>
                <!-- [%X{traceId}] - identyfikator korelacji z MDC (patrz TraceIdFilter).
                     Pozwala wyfiltrować z logów wszystkie linie jednego żądania. -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>10GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <!-- Ważne logi z aplikacji -->
        <logger name="com.example.filetranslator" level="INFO"/>
        <!-- Ostrzeżenia z Spring -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.security" level="INFO"/>
    </springProfile>

</configuration>

