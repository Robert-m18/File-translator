# Wzorzec pliku .env dla docker compose.
#
#   cp .env.example .env      i wpisz swój klucz
#
# .env jest w .gitignore, więc klucz NIE trafi do repozytorium. Ten plik (.env.example)
# trafia - i dlatego nie wolno wpisywać tu prawdziwych wartości.
#
# docker compose czyta .env z katalogu projektu automatycznie i podstawia te wartości
# pod ${...} w docker-compose.yml. Bez pliku .env obowiązują wartości domyślne,
# czyli dostawca "echo".

# echo  - atrapa: oznacza każdą linię kodem języka, nic nie wychodzi na zewnątrz,
#         klucz niepotrzebny. Dobre do oglądania interfejsu i do testów.
# deepl - prawdziwe tłumaczenie. Wymaga klucza poniżej.
TRANSLATION_PROVIDER=echo

# Klucz z konta DeepL API Free (https://www.deepl.com/pro-api).
# UWAGA na adres: konta DARMOWE odpytują https://api-free.deepl.com/v2, płatne
# https://api.deepl.com/v2. Pomyłka kończy się odpowiedzią 403, która wygląda dokładnie
# jak nieprawidłowy klucz - domyślnie skonfigurowany jest wariant darmowy.
DEEPL_API_KEY=

# Logowanie przez konto Google (opcjonalne).
#
# Puste = logowanie przez Google jest WYŁĄCZONE i aplikacja wypisuje o tym WARN przy
# starcie. Nie jest to awaria: rejestracja i logowanie hasłem działają bez tego.
#
# Wartości bierze się z Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID (typ "Web application"). W tym samym miejscu trzeba dopisać adres
# powrotny, CO DO ZNAKU:
#
#   http://localhost:8080/login/oauth2/code/google
#
# Niezgodność adresu odbija się po stronie Google komunikatem redirect_uri_mismatch,
# jeszcze zanim żądanie dotrze do naszej aplikacji - więc w naszych logach nie ma po niej śladu.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
